Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\n", "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"Ueff", "[", 
     RowBox[{"R_", ",", "R0_", ",", "\[Sigma]0_"}], "]"}], ":=", 
    RowBox[{
     FractionBox[
      SuperscriptBox["c", "2"], "4"], "  ", 
     RowBox[{"(", 
      RowBox[{"2", "-", 
       FractionBox[
        RowBox[{"2", " ", "G", " ", "mminus"}], 
        RowBox[{
         SuperscriptBox["c", "2"], " ", "R"}]], "-", 
       FractionBox[
        RowBox[{"2", " ", "G", " ", "mplus"}], 
        RowBox[{
         SuperscriptBox["c", "2"], " ", "R"}]], "-", 
       FractionBox[
        RowBox[{
         SuperscriptBox["R", "2"], " ", "\[CapitalLambda]minus"}], "3"], "-", 
       FractionBox[
        RowBox[{
         SuperscriptBox["R", "2"], " ", "\[CapitalLambda]plus"}], "3"], "-", 
       FractionBox[
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"1", "+", "\[Lambda]"}], ")"}], "2"], " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{"6", " ", "G", " ", 
             RowBox[{"(", 
              RowBox[{"mminus", "-", "mplus"}], ")"}]}], "+", 
            RowBox[{
             SuperscriptBox["c", "2"], " ", 
             SuperscriptBox["R", "3"], " ", 
             RowBox[{"(", 
              RowBox[{"\[CapitalLambda]minus", "-", "\[CapitalLambda]plus"}], 
              ")"}]}]}], ")"}], "2"]}], 
        RowBox[{"288", " ", 
         SuperscriptBox["G", "2"], " ", 
         SuperscriptBox["\[Pi]", "2"], " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             SuperscriptBox["R0", "2"], " ", 
             SuperscriptBox[
              RowBox[{"(", 
               FractionBox["R0", "R"], ")"}], 
              RowBox[{"2", " ", "\[Lambda]"}]], " ", 
             RowBox[{"(", 
              RowBox[{"1", "+", "w0"}], ")"}]}], "+", 
            RowBox[{
             SuperscriptBox["R", "2"], " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "w0"}], "+", "\[Lambda]"}], ")"}]}]}], ")"}], 
          "2"], " ", 
         SuperscriptBox["\[Sigma]0", "2"]}]], "-", 
       FractionBox[
        RowBox[{"8", " ", 
         SuperscriptBox["G", "2"], " ", 
         SuperscriptBox["\[Pi]", "2"], " ", 
         SuperscriptBox["R", "2"], " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "w0"}], "+", 
            RowBox[{
             SuperscriptBox[
              RowBox[{"(", 
               FractionBox["R0", "R"], ")"}], 
              RowBox[{"2", " ", 
               RowBox[{"(", 
                RowBox[{"1", "+", "\[Lambda]"}], ")"}]}]], " ", 
             RowBox[{"(", 
              RowBox[{"1", "+", "w0"}], ")"}]}], "+", "\[Lambda]"}], ")"}], 
          "2"], " ", 
         SuperscriptBox["\[Sigma]0", "2"]}], 
        RowBox[{
         SuperscriptBox["c", "4"], " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"1", "+", "\[Lambda]"}], ")"}], "2"]}]]}], ")"}]}]}], "\n",
    "\n", "\n", "\n", "\n", 
   RowBox[{"Plot1", "=", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"Ueff", "[", 
        RowBox[{"R", ",", "R01", ",", "\[Sigma]01"}], "]"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"R", ",", 
        RowBox[{"0.001", " ", "R01"}], ",", 
        RowBox[{"2", " ", "R01"}]}], "}"}], ",", 
      RowBox[{"Frame", "->", "True"}], ",", 
      RowBox[{"FrameLabel", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{"\"\<R (m)\>\"", ",", "14", ",", "Bold"}], "]"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{
          "\"\<\!\(\*SubscriptBox[\(U\), \(eff\)]\)\>\"", ",", "14", ",", 
           "Bold"}], "]"}]}], "}"}]}], ",", 
      RowBox[{"FrameStyle", "->", "Thick"}], ",", 
      RowBox[{"PlotRange", "->", "All"}], ",", 
      RowBox[{"GridLines", "->", "Automatic"}], ",", 
      RowBox[{"GridLinesStyle", "->", "LightGray"}], ",", 
      RowBox[{"Axes", "->", "False"}], ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"Blue", ",", "Thick"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"Red", ",", "Dashed"}], "}"}]}], "}"}]}], ",", 
      RowBox[{"ImageSize", "->", "Large"}], ",", 
      RowBox[{"LabelStyle", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"FontFamily", "->", "\"\<Times\>\""}], ",", 
         RowBox[{"FontSize", "->", "18"}]}], "}"}]}], ",", 
      RowBox[{"PlotLegends", "->", 
       RowBox[{"Placed", "[", 
        RowBox[{
         RowBox[{"LineLegend", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"Style", "[", 
             RowBox[{
             "\"\<\!\(\*SubscriptBox[\(w\), \(0\)]\)=-0.10\>\"", ",", "20"}], 
             "]"}], "}"}], ",", 
           RowBox[{"LegendMargins", "->", "5"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"0.2", ",", "0.4"}], "}"}]}], "   ", 
        RowBox[{"(*", 
         RowBox[{"position", " ", "inside", " ", "the", " ", "plot"}], "*)"}],
         "]"}]}]}], "]"}]}]}]}]], "Input",
