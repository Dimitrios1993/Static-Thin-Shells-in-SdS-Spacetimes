Cell[BoxData[{
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "currentVeff", ",", "currentEq1", ",", "currentEq2", ",", 
        "currentSigmaCond"}], "}"}], "=", 
      RowBox[{"DefineEquations", "[", "rVal", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Scanning Ratio L+/L- = \>\"", ",", 
       RowBox[{"NumberForm", "[", 
        RowBox[{"rVal", ",", 
         RowBox[{"{", 
          RowBox[{"3", ",", "2"}], "}"}]}], "]"}], ",", "\"\<...\>\""}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"finalEq1", "=", 
         RowBox[{"currentEq1", "/.", " ", 
          RowBox[{"w0", "->", "wVal"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"finalEq2", "=", 
         RowBox[{"currentEq2", "/.", " ", 
          RowBox[{"w0", "->", "wVal"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"finalVeffCond", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"currentVeff", "/.", " ", 
            RowBox[{"w0", "->", "wVal"}]}], ")"}], ">", "0"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"sol", "=", 
         RowBox[{"TimeConstrained", "[", 
          RowBox[{
           RowBox[{"FindInstance", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"finalEq1", ",", "finalEq2", ",", "finalVeffCond", ",", 
               RowBox[{"currentSigmaCond", "<", "0"}], ",", 
               RowBox[{"R0", ">", "0"}], ",", 
               RowBox[{"\[Sigma]0", ">", "0"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"R0", ",", "\[Sigma]0"}], "}"}], ",", "Reals"}], "]"}], 
           ",", "5.0"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Head", "[", "sol", "]"}], "===", "List"}], "&&", 
           RowBox[{
            RowBox[{"Length", "[", "sol", "]"}], ">", "0"}]}], ",", 
          RowBox[{
           RowBox[{"rFound", "=", 
            RowBox[{"R0", "/.", " ", 
             RowBox[{"sol", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}]}], ";", 
           RowBox[{"sFound", "=", 
            RowBox[{"\[Sigma]0", "/.", " ", 
             RowBox[{"sol", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}]}], ";", 
           RowBox[{"status", "=", "1"}]}], ",", 
          RowBox[{
           RowBox[{"rFound", "=", "0"}], ";", 
           RowBox[{"sFound", "=", "0"}], ";", 
           RowBox[{"status", "=", "0"}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"scanData", ",", 
          RowBox[{"{", 
           RowBox[{
           "rVal", ",", "wVal", ",", "status", ",", "rFound", ",", "sFound"}],
            "}"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"wVal", ",", "wStart", ",", "wEnd", ",", "wStep"}], "}"}]}], 
      "]"}]}], ",", 
    RowBox[{"{", 
